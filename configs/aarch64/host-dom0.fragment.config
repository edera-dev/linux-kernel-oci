#
# Edera kernel config snippet
# - Generated from delta config: configs/aarch64/host-dom0.fragment.config
# - Against base config: configs/aarch64/host.config
#
# The host kernel for Xen installs, which only boot it as dom0. The base host
# config also serves KVM hosts; this variant drops what only they and guests
# use, and the hardware, protocols and services a dom0 does not need.

# No audio, video capture or infrared hardware on hosts.
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_RC_CORE=n

# No radios on hosts.
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BT=n
CONFIG_NFC=n
CONFIG_CAN=n
CONFIG_HAMRADIO=n
CONFIG_IEEE802154=n

# Legacy buses, client input devices and platforms, and staging drivers
# that servers do not need.
CONFIG_PARPORT=n
CONFIG_IIO=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_STAGING=n
CONFIG_CHROME_PLATFORMS=n
CONFIG_SURFACE_PLATFORMS=n
CONFIG_USB_SERIAL=n

# GPUs are passed to zones, whose kernels carry the drivers.
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_NOUVEAU=n

# Network protocols the host does not use. Most autoload from an
# unprivileged socket() call.
CONFIG_ATALK=n
CONFIG_ATM=n
CONFIG_X25=n
CONFIG_LAPB=n
CONFIG_RDS=n
CONFIG_TIPC=n
CONFIG_PHONET=n
CONFIG_AF_RXRPC=n
CONFIG_LLC2=n
CONFIG_NET_KEY=n
CONFIG_L2TP=n
CONFIG_QRTR=n

# Queueing disciplines and classifiers the host does not use; tc in a
# user namespace can load them.
CONFIG_NET_SCH_CBS=n
CONFIG_NET_SCH_ETF=n
CONFIG_NET_SCH_TAPRIO=n
CONFIG_NET_SCH_SKBPRIO=n
CONFIG_NET_SCH_PLUG=n
CONFIG_NET_SCH_CHOKE=n
CONFIG_NET_SCH_GRED=n
CONFIG_NET_SCH_SFB=n
CONFIG_NET_SCH_HHF=n
CONFIG_NET_SCH_QFQ=n
CONFIG_NET_SCH_DRR=n
CONFIG_NET_SCH_HFSC=n
CONFIG_NET_CLS_ROUTE4=n
CONFIG_NET_CLS_FW=n

# Binder; any user namespace can mount binderfs.
CONFIG_ANDROID_BINDER_IPC=n

# Legacy and root-to-kernel interfaces the host does not use.
CONFIG_LEGACY_TIOCSTI=n
CONFIG_LDISC_AUTOLOAD=n
CONFIG_DEVMEM=n
CONFIG_ACPI_TABLE_UPGRADE=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n

# Xen backends protect does not use.
CONFIG_XEN_PVCALLS_BACKEND=n
CONFIG_XEN_SCSI_BACKEND=n

# Debug and test options that do not belong in a production kernel.
CONFIG_XFS_DEBUG=n
CONFIG_ACPI_DEBUG=n
CONFIG_MMC_TEST=n
CONFIG_USB_TEST=n
CONFIG_RTC_DRV_TEST=n

# Flash filesystems and flash chip drivers. MTD itself stays for
# Solarflare's SFC_MTD.
CONFIG_MTD_UBI=n
CONFIG_JFFS2_FS=n
CONFIG_MTD_RAW_NAND=n
CONFIG_MTD_SPI_NAND=n
CONFIG_MTD_ONENAND=n
CONFIG_MTD_CFI=n
CONFIG_MTD_JEDECPROBE=n
CONFIG_MTD_PHRAM=n
CONFIG_MTD_SLRAM=n
CONFIG_MTD_BLOCK=n
CONFIG_MTD_HYPERBUS=n

# Graviton and Grace are ACPI/SBSA platforms that need no ARCH_* option,
# except for Grace's ACPI drivers under ARCH_TEGRA. GPIO_TEGRA186 and
# SOC_TEGRA_CBB depend on the Tegra 186, 194 or 234 SoC option rather
# than 241, so 194 stays alongside 241.
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_AXIADO=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BLAIZE=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_QCOM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_SOPHGO=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n
CONFIG_ARCH_CIX=n
CONFIG_ARCH_TEGRA_132_SOC=n
CONFIG_ARCH_TEGRA_210_SOC=n
CONFIG_ARCH_TEGRA_186_SOC=n
CONFIG_ARCH_TEGRA_234_SOC=n
CONFIG_ARCH_TEGRA_264_SOC=n
CONFIG_DRM_TEGRA=n
CONFIG_TEGRA_HOST1X=n

# File servers, mesh networking, serial-line protocols and NTFS that the
# host does not use.
CONFIG_SMB_SERVER=n
CONFIG_NFSD=n
CONFIG_BATMAN_ADV=n
CONFIG_PPP=n
CONFIG_SLIP=n
CONFIG_N_HDLC=n
CONFIG_NTFS3_FS=n
CONFIG_NTFS_FS=n

# This kernel only boots as a Xen dom0. KVM, VFIO and vhost serve the KVM
# host path, and KVM installs run on the distribution kernel.
CONFIG_KVM=n
CONFIG_VFIO=n
CONFIG_VHOST_MENU=n

# dom0 runs on Xen, never directly on KVM, so KVM guest support is unused.
CONFIG_PTP_1588_CLOCK_KVM=n

# VMware virtual hardware, outside the supported platforms.
CONFIG_VMXNET3=n

# virtio-balloon is unsafe under Xen; the protect installer denylists it.
CONFIG_VIRTIO_BALLOON=n

# Xen frontends: dom0 runs the backends.
CONFIG_XEN_BLKDEV_FRONTEND=n
CONFIG_XEN_NETDEV_FRONTEND=n
CONFIG_XEN_SCSI_FRONTEND=n
CONFIG_XEN_FBDEV_FRONTEND=n
CONFIG_INPUT_XEN_KBDDEV_FRONTEND=n
