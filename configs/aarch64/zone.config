CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0
CONFIG_WATCHDOG_SYSFS=y

#
# Graphics/GPU is off in the aarch64 zone kernel. Zones get their console over
# virtio-console/hvc, not a framebuffer.
#
# Only prompted symbols are listed; the helper symbols under them have no
# prompt and follow automatically once these are off.
# CONFIG_ACPI_VIDEO is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_VGA_CONSOLE is not set

#
# Hardware classes a zone is not expected to have: its network and disk arrive
# over virtio, so entire physical-device subsystems are pinned off rather than
# left to Kconfig defaults.
#
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_RFKILL is not set
# CONFIG_NFC is not set
# CONFIG_BT is not set
# CONFIG_HAMRADIO is not set
# CONFIG_CAN is not set
# CONFIG_WWAN is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_MTD is not set
# CONFIG_PCCARD is not set
# CONFIG_FIREWIRE is not set
# CONFIG_PARPORT is not set
# CONFIG_IIO is not set
# CONFIG_STAGING is not set
# CONFIG_MACINTOSH_DRIVERS is not set
# CONFIG_HWMON is not set

# Note: THERMAL cannot be pinned off here. ACPI is on for arm64 and both
# ACPI_PROCESSOR and ACPI_THERMAL select it, so a disable line is silently
# reverted. (Same reason it was dropped from the x86_64 config.)

# Consumer-IR / remote controls. RC_CORE is its own menuconfig
# (drivers/media/rc/Kconfig) and is NOT under MEDIA_SUPPORT, so disabling media
# leaves it on -- it was building 285 keymap modules on its own.
#
# CONFIG_RC_CORE is not set

# No USB/Bluetooth human-interface devices in a headless zone. The game-pad
# drivers (HID_SONY, HID_NINTENDO, HID_PLAYSTATION, HID_ASUS) select
# POWER_SUPPLY back on.
#
# CONFIG_HID_SUPPORT is not set

# No pointing devices; these select SERIO back on.
#
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_RMI4_CORE is not set
# CONFIG_I2C_TAOS_EVM is not set

# No USB Type-C port controllers or Apple fast-charge; each selects
# POWER_SUPPLY, which ARM64 already forces on regardless.
# CONFIG_TYPEC is not set
# CONFIG_APPLE_MFI_FASTCHARGE is not set

# No PS/2 console input; a zone's console is virtio-console/hvc.
#
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_MOUSE_PS2 is not set
# CONFIG_SERIO is not set

# Note: POWER_SUPPLY cannot be pinned off here; CONFIG_ARM64 selects it.

CONFIG_DUMMY_CONSOLE_COLUMNS=80
CONFIG_DUMMY_CONSOLE_ROWS=25

# No USB in a zone. There is no physical bus to attach to, and USB devices are
# not passed through; a zone's disks and NICs arrive over virtio. USB_SUPPORT is
# the menuconfig everything under drivers/usb depends on.
#
# Note drivers/Makefile descends into usb/ on CONFIG_PCI as well, so empty
# built-in.a archives still appear in the build log. Only CC lines are work.
#
# CONFIG_USB_SUPPORT is not set

# USB4/Thunderbolt lives in drivers/thunderbolt and depends only on PCI, so it
# survives USB_SUPPORT being off. Off by default on arm64; pinned so a defconfig
# change cannot bring it back.
#
# CONFIG_USB4 is not set

CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"
CONFIG_RTC_NVMEM=y

CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_PROC=y
CONFIG_RTC_INTF_DEV=y

CONFIG_SYNC_FILE=y

CONFIG_VIRT_DRIVERS=y
CONFIG_VMGENID=y
CONFIG_VIRTIO_FS=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VHOST_MENU=y

# x86-only Xen symbols are deliberately absent here: XEN_PCIDEV_FRONTEND
# and XEN_PCIDEV_BACKEND, XEN_ACPI_PROCESSOR, XEN_SYMS all require X86 or
# XEN_PV, and XEN_MEMORY_HOTPLUG_LIMIT requires XEN_HAVE_PVMMU.
CONFIG_XEN_BALLOON=y
CONFIG_XEN_BALLOON_MEMORY_HOTPLUG=y
CONFIG_XEN_SCRUB_PAGES_DEFAULT=y
CONFIG_XEN_DEV_EVTCHN=y
CONFIG_XEN_BACKEND=y
CONFIG_XENFS=y
CONFIG_XEN_COMPAT_XENFS=y
CONFIG_XEN_SYS_HYPERVISOR=y
CONFIG_XEN_GNTDEV=y
CONFIG_XEN_GRANT_DEV_ALLOC=y
CONFIG_XEN_PRIVCMD=y
CONFIG_XEN_VIRTIO=y
CONFIG_COMMON_CLK=y

CONFIG_COMMON_CLK_HI3670=y

CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
CONFIG_FSL_ERRATUM_A008585=y
CONFIG_HISILICON_ERRATUM_161010101=y
CONFIG_ARM64_ERRATUM_858921=y
CONFIG_ARM_TIMER_SP804=y

CONFIG_MAILBOX=y
