# Edera zone kernel variant: ThinLTO (Clang) codegen.
#
# The one genuinely build-time-only lever: link-time optimization changes the kernel binary's
# codegen and cannot be reproduced at runtime or via a boot flag. Requires building under Clang
# + lld -- the buildenv installs clang-18/lld-18 from apt.llvm.org (bookworm's clang-14 is too
# old for the kernel) and build.sh/common.sh pass LLVM=-18 for this flavor only (others stay
# GCC). The config step itself must run under Clang, or CC_IS_CLANG/LD_IS_LLD are false and
# olddefconfig drops LTO_CLANG_THIN back to LTO_NONE.
CONFIG_LTO_CLANG_THIN=y
# resolve_btfids fails on ThinLTO-linked vmlinux ("Invalid argument"); pahole/BTF
# does not survive the LTO link on 6.18. Bench binaries don't use BTF, so skip it.
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
