# Edera zone kernel variant: PREEMPT_RT (real-time, fully preemptible).
#
# Latency axis: bounds worst-case wake-up latency under load. none/voluntary/full
# preemption are already runtime-switchable on the base zone kernel via
# PREEMPT_DYNAMIC (the preempt= cmdline), so RT is the only preemption model that
# genuinely needs its own build.
#
# CONFIG_PREEMPT_RT=y flips the preemption choice (olddefconfig unsets
# CONFIG_PREEMPT_NONE). PREEMPT_DYNAMIC is incompatible with RT (it depends on
# !PREEMPT_RT) and would be dropped anyway; it is unset explicitly so the intent
# is auditable in the fragment.
CONFIG_PREEMPT_RT=y
# CONFIG_PREEMPT_DYNAMIC is not set
