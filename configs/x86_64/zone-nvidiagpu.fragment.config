#
# Edera kernel config snippet
# - Generated from delta config: configs/x86_64/zone-amdgpu.fragment.config
# - Against base config: /tmp/tmp.pTwNs4lJKY-zone-5.4.293-amd64/kernel/config
#
CONFIG_PCI_DEBUG=y
CONFIG_DRM=y
CONFIG_DRM_CLIENT=y
CONFIG_DRM_CLIENT_LIB=m
CONFIG_DRM_CLIENT_SELECTION=m
CONFIG_DRM_CLIENT_SETUP=y


CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_DISPLAY_HDCP_HELPER=y
CONFIG_DRM_DISPLAY_HDMI_HELPER=y
CONFIG_DRM_I915=n
CONFIG_DRM_NOUVEAU=n

# WMI lives under X86_PLATFORM_DEVICES, which the base zone.config turns off.
# State it here rather than relying on another driver to drag it back in.
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_ACPI_WMI=y
CONFIG_WMI_BMOF=y
CONFIG_MXM_WMI=y

#
# Graphics stack the base zone.config turns off. Re-enabled here because this
# flavor drives a real GPU. Select-only symbols are omitted; they follow.
#
CONFIG_VGA_ARB=y
CONFIG_VGA_ARB_MAX_GPUS=16
CONFIG_VGA_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_AGP=y
CONFIG_AGP_AMD64=y
CONFIG_AGP_INTEL=y
CONFIG_ACPI_VIDEO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_XEN_FBDEV_FRONTEND=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

CONFIG_CMA=y
CONFIG_CMA_DEBUGFS=y
CONFIG_CMA_SYSFS=y
CONFIG_CMA_AREAS=8
CONFIG_DMA_CMA=y
CONFIG_DMA_NUMA_CMA=y

CONFIG_CMA_SIZE_MBYTES=0
CONFIG_CMA_SIZE_SEL_MBYTES=y
CONFIG_CMA_ALIGNMENT=8
